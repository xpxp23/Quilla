{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tauri-apps/api/core": ["src/tauri-compat/core.ts"],
      "@tauri-apps/api/event": ["src/tauri-compat/event.ts"],
      "@tauri-apps/api/webview": ["src/tauri-compat/webview.ts"]
    }
  },
  "include": ["src"]
}
