{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Quilla",
    "version": "0.15.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": true
      },
      "dialog": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "app.quilla.editor",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "category": "Utility",
      "shortDescription": "Quilla (羽墨) - 现代化所见即所得 Markdown 编辑器与本地双链知识库",
      "longDescription": "基于 Rust + Tauri v1.8 + CodeMirror 6 Lezer AST 打造的高性能所见即所得 Markdown 编辑器与双链知识库工作台，深度适配 Windows 与银河麒麟操作系统 V10 SP1 / V11 2503（x86_64 / AArch64 / LoongArch64）。",
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.0-37",
          "libsoup2.4-1",
          "xdg-utils"
        ]
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:*"
    },
    "windows": [
      {
        "label": "main",
        "title": "Quilla",
        "width": 1080,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "center": true,
        "fileDropEnabled": true
      }
    ]
  }
}
